<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PhysicalMonitorSizeChanger.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PhysicalMonitorSizeChanger"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28">
        <StackPanel MaxWidth="560" Spacing="16" HorizontalAlignment="Left">
            <TextBlock Text="디스플레이 물리 크기 변경" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="모니터의 물리적 크기를 변경합니다."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
